<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
    <add key="MonitoringIntervalMinutes" value="1" />
		<add key="DebugMode" value="False" />
		<add key="AppName" value="User Account Lockout Monitoring Service" />
		<add key="smtpServer" value="smtphost" />
		<add key="DefaultMailTo" value="usermonitoring@yourorganisation" />
		<add key="MailFrom" value="usermonitoring@yourorganisation" />
		<add key="Subject" value="User Account Lockout Monitoring Alert" />
	</appSettings>
</configuration>